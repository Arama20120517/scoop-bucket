{
    "version": "2.5.0",
    "description": "Easily download and manage single-player game cheats for your convenience.",
    "homepage": "https://github.com/dyang886/Game-Cheats-Manager",
    "license": "GPL-3.0-only",
    "notes": [
        "Do not install 'games/wand', otherwise it won't be detected in the trainer management page.",
        "Please install the suggested 'arama/wand' instead for proper detection."
    ],
    "suggest": {
        "Wand (WeMod)": "arama/wand"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/dyang886/Game-Cheats-Manager/releases/download/v2.5.0/Game.Cheats.Manager.Setup.2.5.0.exe",
            "hash": "efa6ac43337f29b39e1a23aa722746237db0e8a1253715d9ec42c84f5e2b46aa"
        }
    },
    "innosetup": true,
    "post_install": [
        "if (Test-Path \"$env:APPDATA\\GCM Settings\") {",
        "    Copy-Item -Path \"$env:APPDATA\\GCM Settings\\*\" -Destination \"$persist_dir\\data\" -Force -Recurse",
        "    Remove-Item \"$env:APPDATA\\GCM Settings\" -Force -Recurse",
        "}",
        "if (Test-Path \"$env:APPDATA\\GCM Trainers\") {",
        "    Copy-Item -Path \"$env:APPDATA\\GCM Trainers\\*\" -Destination \"$persist_dir\\backup\" -Force -Recurse",
        "    Remove-Item \"$env:APPDATA\\GCM Trainers\" -Force -Recurse",
        "}",
        "New-Item -ItemType Junction -Path \"$env:APPDATA\\GCM Settings\" -Target \"$persist_dir\\settings\" | Out-Null",
        "New-Item -ItemType Junction -Path \"$env:APPDATA\\GCM Trainers\" -Target \"$persist_dir\\trainers\" | Out-Null"
    ],
    "post_uninstall": [
        "Remove-Item \"$env:APPDATA\\GCM Settings\" -Force -Recurse",
        "Remove-Item \"$env:APPDATA\\GCM Trainers\" -Force -Recurse"
    ],
    "persist": ["settings", "trainers"],
    "shortcuts": [["Game Cheats Manager.exe", "Game Cheats Manager"]],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dyang886/Game-Cheats-Manager/releases/download/v$version/Game.Cheats.Manager.Setup.$version.exe"
            }
        }
    }
}

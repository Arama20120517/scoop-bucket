    },
    "pre_install": "if (!(is_admin)) { throw 'Admin privileges are required.' }",
    "post_install": [
        "if (Test-Path $env:LOCALAPPDATA\\mVolt+) {",
        "    Copy-Item -Path $env:LOCALAPPDATA\\mVolt+\\* -Destination \"$persist_dir\\data\" -Force -Recurse",
        "    Remove-Item $env:LOCALAPPDATA\\mVolt+ -Force -Recurse",
        "}",
        "if (Test-Path $env:ProgramFiles\\mVolt+) {",
        "    Copy-Item -Path $env:ProgramFiles\\mVolt+\\* -Destination \"$persist_dir\\startup\" -Force -Recurse",
        "    Remove-Item $env:ProgramFiles\\mVolt+ -Force -Recurse",
        "}",
        "New-Item -ItemType Junction -Path $env:LOCALAPPDATA\\mVolt+ -Target $persist_dir\\data | Out-Null",
        "New-Item -ItemType Junction -Path $env:ProgramFiles\\mVolt+ -Target $persist_dir\\startup | Out-Null"
    ],
    "pre_uninstall": "if (!(is_admin)) { throw 'Admin privileges are required.' }",
    "post_uninstall": [
        "Remove-Item $env:LOCALAPPDATA\\mVolt+ -Force -Recurse",
        "Remove-Item $env:ProgramFiles\\mVolt+ -Force -Recurse"
    ],
    "persist": [
        "data",
        "startup"
    ],
    "shortcuts": [
        [
            "mVolt+.exe",
            "mVolt"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/b00nz/mVolt/releases/download/v$version/mVolt+.exe",
                "hash": {
                    "url": "https://api.github.com/repos/b00nz/mVolt/releases/tags/v$version",

{
    "version": "1.0.0",
    "description": "Scoop 下载加速器. 支持将 GitHub、SourceForge、Node.js 的请求重定向至国内高速镜像, 告别下载超时.",
    "homepage": "https://github.com/Arama20120517/scoop-accelerator",
    "license": "MIT",
    "notes": [
        "如果需要安装 scoop-i18n, 请按照以下顺序安装, 卸载时请反转顺序: ",
        "1. 安装 scoop-i18n",
        "2. 安装 scoop-accelerator"
    ],
    "architecture": {
        "64bit": {
            "url": "https://v4.gh-proxy.org/https://github.com/Arama20120517/scoop-accelerator/releases/download/v1.0.0/scoop-accelerator.psm1",
            "hash": "97f2ce0137e537bb86301ef630f960b7e70c09b74f23b34a5593f12ae9692ec0"
        }
    },
    "pre_install": [
        "New-Item -ItemType Directory -Path \"$dir\\original\" -Force | Out-Null",
        "New-Item -ItemType Directory -Path \"$dir\\shims\" -Force | Out-Null",
        "$isI18nInstalled = Test-Path $(appdir 'abgox.scoop-i18n')",
        "Get-ChildItem \"$bucketsdir\\$bucket\\scripts\\$app\" | ForEach-Object {",
        "    Move-Item \"$scoopdir\\shims\\$($_.Name)\" \"$dir\\original\"",
        "    $content = Get-Content $_.FullName -Raw",
        "    $content = $content.Replace('${scoop.ps1}', \". '$(appdir scoop)\\current\\bin\\scoop.ps1'\")",
        "    $content = $content.Replace('${scoop-accelerator.ps1}', \". '$dir\\scoop-accelerator.ps1'\")",
        "    if ($isI18nInstalled) {",
        "        $content = $content.Replace('${scoop-i18n.ps1}', \". '$(appdir 'abgox.scoop-i18n')\\current\\app\\scoop-i18n.ps1'\")",
        "    } else {",
        "        $content = $content.Replace('${scoop-i18n.ps1}', '')",
        "    }",
        "    [System.IO.File]::WriteAllText(\"$dir\\shims\\$($_.Name)\", ($content -join [System.Environment]::NewLine), [System.Text.UTF8Encoding]::new($false))",
        "}",
        "Get-ChildItem \"$dir\\shims\" | ForEach-Object {",
        "    Copy-Item $_.FullName \"$scoopdir\\shims\" -Force",
        "}"
    ],
    "pre_uninstall": [
        "Get-ChildItem \"$dir\\original\" | ForEach-Object {",
        "    Move-Item $_.FullName \"$scoopdir\\shims\" -Force",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://v4.gh-proxy.org/https://github.com/Arama20120517/scoop-accelerator/releases/download/v$version/scoop-accelerator.ps1"
            }
        }
    }
}

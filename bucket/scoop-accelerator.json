{
    "version": "1.1.1",
    "description": "Scoop 下载加速器. 支持将 GitHub、SourceForge、Node.js 的请求重定向至国内高速镜像, 告别下载超时.",
    "homepage": "https://github.com/Arama20120517/scoop-accelerator",
    "license": "MIT",
    "notes": "本应用兼容 abgox.scoop-i18n",
    "architecture": {
        "64bit": {
            "url": "https://v4.gh-proxy.org/https://github.com/Arama20120517/scoop-accelerator/releases/download/v1.1.1/scoop-accelerator.ps1",
            "hash": "77c122818774a4bc0994dd65c2b388730424f7ed4fb6b127f98c62d45ff88e07"
        }
    },
    "post_install": [
        "New-Item -ItemType Directory -Path \"$dir\\template\" -Force | Out-Null",
        "New-Item -ItemType Directory -Path \"$dir\\original\" -Force | Out-Null",
        "New-Item -ItemType Directory -Path \"$dir\\shims\" -Force | Out-Null",
        "Get-ChildItem \"$bucketsdir\\$bucket\\scripts\\$app\" | ForEach-Object {",
        "    Copy-Item $_.FullName \"$dir\\template\" -Force",
        "    Move-Item \"$scoopdir\\shims\\$($_.Name)\" \"$dir\\original\"",
        "}",
        ". \"$dir\\scoop-accelerator.ps1\"",
        "if (installed 'abgox.scoop-i18n') {",
        "    Copy-Item \"$(appdir 'abgox.scoop-i18n')\\current\\app\\original\\*\" \"$dir\\original\" -Force",
        "    Update-Shims -EnableI18N",
        "} else {",
        "    Update-Shims",
        "}",
        "Get-ChildItem \"$dir\\shims\" | ForEach-Object {",
        "    Copy-Item $_.FullName \"$scoopdir\\shims\" -Force",
        "}"
    ],
    "pre_uninstall": [
        "if (installed 'abgox.scoop-i18n') {",
        "    Copy-Item \"$(appdir 'abgox.scoop-i18n')\\current\\app\\shims\\*\" \"$scoopdir\\shims\" -Force -Bypass",
        "} else {",
        "    Get-ChildItem \"$dir\\original\" | ForEach-Object {",
        "        Move-Item $_.FullName \"$scoopdir\\shims\" -Force",
        "    }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://v4.gh-proxy.org/https://github.com/Arama20120517/scoop-accelerator/releases/download/v$version/scoop-accelerator.ps1",
                "hash": {
                    "url": "https://api.github.com/repos/Arama20120517/scoop-accelerator/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == 'scoop-accelerator.ps1')].digest"
                }
            }
        }
    }
}
